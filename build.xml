<project name="Account Manager" default="jarfile">
    <description>
        Account Manager
    </description>

  <property name="jarfile" location="accounts.jar"/>

  <property id="main.swing" name="main.swing"
            value="jrb.accounts.swingui.AccountStoreUI"/>
  <property id="main.jfx" name="main.jfx"
            value="jrb.accounts.jfxui.AccountStoreApp"/>

  <!-- can override ui on the commandline w/ -D -->
  <property name="ui" value="swing"/>
  <property name="main" refid="main.${ui}"/>

  <property name="modules" location="${user.home}/lib"/>
  <path id="lib">
    <fileset dir="${modules}">
      <include name="*.jar"/>
    </fileset>
  </path>

  <property environment="env"/>

  <property name="classes" location="classes"/>
  <property name="source.list" location="source-list"/>

  <property name="resources.list" location="resources-list"/>

  <property name="test.classes" location="test-classes"/>
  <property name="tests.list" location="tests-list"/>

  <property name="javadoc" location="javadoc"/>

  <target name="jarfile" depends="compile">
    <jar destfile="${jarfile}" basedir="${classes}"/>
    <exec executable="jar">
      <arg value="-ufe"/>
      <arg value="${jarfile}"/>
      <arg value="${main}"/>
    </exec>
  </target>

  <target name="compile"
	description="compile the sources"
	depends="source-list,resources-list">
    <mkdir dir="${classes}"/>
    <javac sourcepath="" srcdir="${basedir}/src"
        modulepath="${modules}"
        includesfile="${source.list}" destdir="${classes}"
        includeantruntime="false"
        classpathref="lib"/>
    <copy todir="${classes}">
      <fileset dir="${basedir}" includesfile="${resources.list}"/>
    </copy>
  </target>

  <target name="tests"
	description="compile the tests"
	depends="tests-list,jarfile">
    <mkdir dir="${test.classes}"/>
    <javac sourcepath="" srcdir="${basedir}/tests"
            modulepath="${modules}"
	    includesfile="${tests.list}" destdir="${test.classes}"
	    includeantruntime="false">
	<classpath>
	    <pathelement location="${classes}"/>
	    <pathelement path="${env.CLASSPATH}"/>
	</classpath>
    </javac>
    <copy todir="${test.classes}">
	<fileset dir="${basedir}/tests">
	    <include name="test-data/**"/>
	</fileset>
    </copy>
  </target>

  <target name="javadoc"
        description="generate javadoc for all code"
	depends="source-list,tests-list">
    <delete dir="${javadoc}"/>
    <javadoc destdir="${javadoc}" access="package" noqualifier="all">
	<fileset dir="${basedir}/src" includesfile="${source.list}"/>
	<fileset dir="${basedir}/tests" includesfile="${tests.list}"/>
    </javadoc>
  </target>

  <target name="source-list"
          description="find all Java sources under source control">
    <exec executable="git" output="${source.list}" dir="src">
      <arg value="ls-files"/>
      <arg value="."/>
    </exec>
  </target>

  <target name="resources-list"
          description="find all resource files under source control">
    <exec executable="git" output="${resources.list}" dir="${basedir}">
      <arg value="ls-files"/>
      <arg value="resources"/>
    </exec>
  </target>

  <target name="tests-list"
          description="find all Java tests under hg">
    <exec executable="git" output="${tests.list}" dir="tests">
      <arg value="ls-files"/>
      <arg value="jrb"/>
    </exec>
  </target>

  <target name="clean" description="remove generated files">
    <delete dir="${classes}"/>
    <delete dir="${test.classes}"/>
    <delete dir="${javadoc}"/>
    <delete file="${jarfile}"/>
    <delete file="${source.list}"/>
    <delete file="${resources.list}"/>
    <delete file="${tests.list}"/>
  </target>
</project>
