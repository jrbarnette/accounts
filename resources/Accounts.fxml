<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity" minWidth="-Infinity">
   <children>
      <ListView />
      <VBox>
         <TitledPane text="Account Information"> <VBox spacing="5.0">
            <GridPane hgap="5.0">
            <columnConstraints>
               <ColumnConstraints halignment="RIGHT" />
               <ColumnConstraints halignment="LEFT" />
            </columnConstraints>
            <Label text="Account UUIID"
                   GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label text="Replace with UUID"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Description"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField prefColumnCount="35"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="URL"
                   GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField prefColumnCount="35"
                   GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="User Name"
                   GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField prefColumnCount="35"
                   GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <Label text="Password"
                   GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <TextField prefColumnCount="35"
                   GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <Label text="Entry Creation Date"
                   GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <Label text="Replace with timestamp"
                   GridPane.rowIndex="5" GridPane.columnIndex="1" />
            </GridPane>

            <FlowPane alignment="CENTER" hgap="10.0">
            <children>
               <Button mnemonicParsing="false" text=" &lt; " />
               <Button mnemonicParsing="false" text=" &gt; " />
            </children>
            </FlowPane>
         </VBox> </TitledPane>

         <TitledPane animated="false" text="Password Parameters">
         <BorderPane>
            <top>
            <FlowPane alignment="CENTER" hgap="3.0">
               <Label text="Minimum length" />
               <Spinner>
                  <editor>
                     <TextField prefColumnCount="3" />
                  </editor>
               <!--
                  <valueFactory>
                     <SpinnerValueFactory.IntegerSpinnerValueFactory
                        min="1" max="20" amountToStepBy="1" />
                  </valueFactory>
               -->
               </Spinner>
               <Label text="Maximum length" />
               <Spinner />
            </FlowPane>
            </top>
         </BorderPane>
         </TitledPane>

